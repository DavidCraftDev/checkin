generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

enum TrafficLightFeedback {
  GREEN
  YELLOW
  RED
}

model User {
  id            String          @id @default(cuid())
  username      String          @unique
  displayname   String
  permission    Int             @default(0)
  password      String?
  // We keep group as string[] for now as requested/implied simpler migration
  group         String[]        @default([])
  needs         String[]        @default([])
  competence    String[]        @default([])
  courses       String[]
  pwdLastSet    DateTime        @default(now())

  sessions      Session[]
  events        Event[]         @relation("CreatedEvents")
  attendances   Attendance[]    @relation("StudentAttendances")
  studyTimeData StudyTimeData[]

  @@index([username])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Event {
  id          String       @id @default(cuid())
  type        String
  userId      String
  cw          Int
  createdAt   DateTime     @default(now()) @map("created_at")

  user        User         @relation("CreatedEvents", fields: [userId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@index([userId])
  @@index([cw])
  @@map("Events") // Keep table name if possible, or migrate. Let's assume migration to new names.
                  // Wait, "Events" is plural, Prisma defaults to that.
                  // But let's map it to ensure we know what we are doing.
                  // Actually, better to just let Prisma handle it and assume a fresh start/migration script.
}

model Attendance {
  id             String               @id @default(cuid())
  userId         String
  eventId        String
  cw             Int
  teacherNote    String?
  studentNote    String?
  type           String?
  feedback       TrafficLightFeedback @default(GREEN)
  selfReflection String?
  attended       Boolean              @default(true)
  createdAt      DateTime             @default(now()) @map("created_at")

  user           User                 @relation("StudentAttendances", fields: [userId], references: [id], onDelete: Cascade)
  event          Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@index([cw])
  @@map("Attendances")
}

model StudyTimeData {
  id     String   @id @default(cuid())
  userId String
  needs  String[] @default([])
  cw     Int
  year   Int

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ClosedStudyTime {
  lessonId String @id @unique @default(cuid())
  courseId String

  @@map("ClosedStudyTimes")
}
