generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

enum TrafficLightFeedback {
  GREEN
  YELLOW
  RED
}

model Attendances {
  id             String               @id @unique @default(cuid())
  userID         String
  eventID        String
  cw             Int
  teacherNote    String?
  studentNote    String?
  type           String?
  feedback       TrafficLightFeedback @default(GREEN)
  selfReflection String?
  attended       Boolean              @default(true)
  created_at     DateTime             @default(now())
}

model Events {
  id         String   @id @unique @default(cuid())
  type       String
  user       String
  cw         Int
  created_at DateTime @default(now())
}

model StudyTimeData {
  id     String   @id @unique @default(cuid())
  userID String
  needs  String[] @default([])
  cw     Int
  year   Int
}

model User {
  id          String    @id @unique @default(cuid())
  username    String    @unique
  displayname String
  permission  Int       @default(0)
  password    String?
  group       String[]  @default([])
  needs       String[]  @default([])
  competence  String[]  @default([])
  courses     String[]
  pwdLastSet  DateTime  @default(now())
  sessions    Session[]
}

model Session {
  id        String   @id @unique
  userID    String
  expiresAt DateTime
  user      User     @relation(references: [id], fields: [userID], onDelete: Cascade)
}

model LockedStudyTimes {
  lessonID String @id @unique @default(cuid())
  courseID String
}
