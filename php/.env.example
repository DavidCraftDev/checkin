# PostgreSQL Database Connection (Optional)
# If not set, SQLite will be used as fallback (data/database.sqlite)
# Format: postgres://username:password@host:port/database
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/checkin

# Application Settings
MAINTENANCE=false
SCHOOL_NAME=Example School

# Default Admin Login Credentials
# IMPORTANT: Change these in production!
DEFAULT_LOGIN_USERNAME=admin
DEFAULT_LOGIN_PASSWORD=ChangeThisPassword123!

# LDAP Configuration (optional)
LDAP_ENABLE=false
LDAP_URI=ldap://ldap.example.com
LDAP_TLS_REJECT_UNAUTHORIZED=false
LDAP_BIND_DN=cn=readonly,dc=example,dc=com
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=dc=example,dc=com
LDAP_USER_SEARCH_FILTER=(objectClass=person)
LDAP_PASSWORD_RESET_URL=

# LDAP Automatic Data Detection
LDAP_AUTO_PERMISSION=false
LDAP_AUTO_PERMISSION_TEACHER_GROUP=
LDAP_AUTO_PERMISSION_ADMIN_GROUP=
LDAP_AUTO_GROUPS_DETECTION=false
LDAP_AUTO_GROUPS_OU=
LDAP_AUTO_STUDYTIME_DATA=false
LDAP_AUTO_STUDYTIME_DATA_OU=
